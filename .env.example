# NexusPay Configuration
PORT=5000
NODE_ENV=development

# PayPal Developer Sandbox Credentials
# Leave empty to run in instant interactive simulation mode
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# OpenRouter Free LLM Provider
# Powers real autonomous multi-agent reasoning, dynamic negotiations, and Themis AI Arbiter rulings
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_FALLBACK_MODELS=openrouter/auto,liquid/lfm-3-1.7b:free,nvidia/nemotron-3.5-lightning:free
